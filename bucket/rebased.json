    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/DetachHead/rebased/releases/download/1.1.21/rebased.win.zip",
            "hash": "7081bec910f8c440e5a2f41059bb3491cdb49d3f38e70e7189dd95b242482217"
        },
        "arm64": {
            "url": "https://github.com/DetachHead/rebased/releases/download/1.1.21/rebased-aarch64.win.zip",
            "hash": "d8e4ff5651718f9e6d8e2eb58b523251e215e4b63b23985c56884f064a957e89"
        }
    },
    "extract_to": "IDE",
    "installer": {
        "script": "& \"$bucketsdir\\extras\\scripts\\jetbrains\\portable.ps1\" \"$dir\" \"$persist_dir\""
    },
    "bin": [
        [
            "IDE\\bin\\rebased64.exe",
            "rebased"
        ]
    ],
    "shortcuts": [
        [
            "IDE\\bin\\rebased64.exe",
            "Rebased"
        ]
    ],
    "persist": [
        "IDE\\bin\\idea.properties",
        "IDE\\bin\\rebased64.exe.vmoptions",
        "profile"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/DetachHead/rebased/releases/download/$version/rebased.win.zip"
            },
            "arm64": {
                "url": "https://github.com/DetachHead/rebased/releases/download/$version/rebased-aarch64.win.zip"
